# Copy to .env; replace every placeholder before running integrations.
ConnectionStrings__DefaultConnection='Server=127.0.0.1;Port=3308;Database=store_management;User=root;Password='
Jwt__Secret=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
Jwt__Issuer=dotnet-backend
Jwt__Audience=dotnet-frontend
OpenRouter__ApiKey=REPLACE_WITH_OPENROUTER_API_KEY
OpenRouter__Model=kwaipilot/kat-coder-pro:free
OpenRouter__SiteUrl=http://localhost:5192
OpenRouter__SiteName='Store Manager'
VNPay__TmnCode=REPLACE_WITH_VNPAY_TMN_CODE
VNPay__HashSecret=REPLACE_WITH_VNPAY_HASH_SECRET
VNPay__Url=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPay__ReturnUrl=http://localhost:7000/api/customer/vnpay/callback
VNPay__BlazorAppUrl=http://localhost:5192
# S3-compatible storage
# Public bucket: images served as unsigned URLs (no auth needed)
# Private bucket: images served via presigned URLs with expiry (default 60 min)
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=REPLACE_WITH_DEFAULT_BUCKET
AWS_ROOT=REPLACE_WITH_ROOT_PREFIX
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=REPLACE_WITH_S3_ENDPOINT
AWS_URL=REPLACE_WITH_BUCKET_BASE_URL
AWS_PUBLIC_BUCKET=public
AWS_PUBLIC_URL=REPLACE_WITH_PUBLIC_BASE_URL
AWS_PRIVATE_BUCKET=private
AWS_PRIVATE_URL=
Email__User=REPLACE_WITH_SMTP_EMAIL
Email__Pass=REPLACE_WITH_SMTP_APP_PASSWORD
