[Unit]
Description=OnlineMarket staging API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=onlinemarket-staging
Group=onlinemarket-staging
WorkingDirectory=/opt/onlinemarket-staging/current/api
EnvironmentFile=/opt/onlinemarket-staging/shared/staging.env
Environment=ASPNETCORE_ENVIRONMENT=Staging
Environment=ASPNETCORE_URLS=http://127.0.0.1:17000
Environment=TZ=Asia/Ho_Chi_Minh
ExecStart=/opt/onlinemarket-staging/current/api/dotnet-backend
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
SyslogIdentifier=onlinemarket-staging
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/onlinemarket-staging/shared
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
MemoryHigh=512M
MemoryMax=768M
TasksMax=256

[Install]
WantedBy=multi-user.target
